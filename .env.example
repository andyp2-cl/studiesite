# Copy to .env.local and fill in. Never commit .env.local.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
# The anon key (or the newer "publishable" key) – safe for the browser, RLS applies.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses RLS. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (server only)
ANTHROPIC_API_KEY=
# Cheapest current Haiku-class model, e.g. for solution feedback
AI_MODEL_CHEAP=
# Mid-tier Sonnet-class model, for reading PDFs/photos (phase 2)
AI_MODEL_SMART=
