# Copy to .env.local and fill in. Never commit .env.local.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
# The anon key (or the newer "publishable" key) – safe for the browser, RLS applies.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses RLS. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (server only). Leave the key empty to run without AI.
# platform.claude.com → Settings → API keys. Prepay credits with auto-reload off.
ANTHROPIC_API_KEY=
# Cheapest current Haiku-class model, for feedback and grading
AI_MODEL_CHEAP=claude-haiku-5-5
# Mid-tier Sonnet-class model, for drafting content from sources
AI_MODEL_SMART=claude-sonnet-5-5
